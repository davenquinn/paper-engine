#!/usr/bin/env zsh
# Upload the built .docx to Google Drive, converting it to a native Google Doc.
#
# Uploads to a *fixed path*, so the Doc keeps its ID (and therefore its URL and
# its sharing settings) across rebuilds. Reviewers can keep the same link.
#
# One-time setup:
#   rclone config          # create a remote of type "drive"
# then in paper-defs.zsh:
#   GDRIVE_REMOTE="gdrive"
#   GDOC_PATH="Proposals/Rockd PESOSE 2026"

source "$PAPER_COMPONENTS/env.zsh"

remote="${GDRIVE_REMOTE}"
docpath="${GDOC_PATH}"
file=""

while [[ "$#" -gt 0 ]]; do case $1 in
  -r|--remote) remote="$2"; shift;;
  -p|--path) docpath="$2"; shift;;
  *) file="$1";;
esac; shift; done

if [ -z "$remote" ]; then
  >&2 echo "No Google Drive remote set. Add GDRIVE_REMOTE to paper-defs.zsh,"
  >&2 echo "or pass --remote. Configure the remote itself with 'rclone config'."
  exit 1
fi

if ! rclone listremotes | grep -qx "$remote:"; then
  >&2 echo "rclone remote '$remote' is not configured. Run 'rclone config'."
  exit 1
fi

file="${file:-$PAPER_DIR/output/$name.docx}"
if [ ! -f "$file" ]; then
  >&2 echo "Not built yet: $file"
  >&2 echo "Run 'paper create-docx --summary' first."
  exit 1
fi

docpath="${docpath:-$name}"

>&2 echo "Uploading $(basename $file) -> $remote:$docpath"

# --drive-import-formats converts the upload into a native Google Doc rather
# than parking a .docx file in Drive.
rclone copyto "$file" "$remote:$docpath" \
  --drive-import-formats docx \
  --ignore-checksum \
  --progress || exit 1

id=$(rclone lsjson "$remote:$docpath" 2>/dev/null | python3 -c "
import json, sys
try:
    entries = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for e in entries:
    print(e.get('ID', ''))
    break
")

if [ -n "$id" ]; then
  echo "https://docs.google.com/document/d/$id/edit"
else
  >&2 echo "Uploaded, but could not resolve the document ID."
fi
