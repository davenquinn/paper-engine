#!/usr/bin/env zsh
# Uses new signature in which 'PAPER_DIR' environment variable must be defined
source "$PAPER_COMPONENTS/env.zsh"

includes="$PAPER_DIR/build/converted-includes"

pc="$PAPER_COMPONENTS"

rev_args=(--captions)
full=0

while [[ "$#" -gt 0 && "$1" == --* ]]; do
  case $1 in
    --summary) rev_args+=(--summary); shift;;
    --full) full=1; shift;;
    *) break;;
  esac
done

if [ $full = 1 ]; then
  figure_defs="${PAPER_CONTENT_DIR:-text}/includes.yaml"
  collect_dir="${FIGURE_COLLECT_DIR:-build/figures}"
  mkdir -p "$collect_dir"

  # Collect figures into a centralized directory, then rasterize them.
  # '.' first: includes.yaml paths are written relative to the paper dir.
  figurator collect \
    $figure_defs \
    $collect_dir \
    . ${FIGURE_SEARCH_DIRECTORIES}

  paper convert-includes "$collect_dir" "$includes"

  paper compile-refs
fi

text=build/text.md
rm -f $text
paper rev-text "${rev_args[@]}" \
| prepare-crossref \
| sed "s/º/°/g" \
> $text

# Get rid of abstract otherwise it will be numbered
sed -i '' "s/\# Abstract {-}//g" $text

echo "# References {-}\n\n" >> $text

cat $text \
| pandoc \
  --from markdown \
  --to docx+styles \
  --metadata-file=$PAPER_DIR/text/meta.yaml \
  --metadata-file="$pc/defs/pandoc-crossref.yaml" \
  --metadata includes-spec="$PAPER_DIR/text/includes.yaml" \
  --metadata includes-dir=$includes \
  --metadata includes-only="tbl" \
  --reference-doc="$pc/templates/reference.docx" \
  --bibliography="$PAPER_DIR/build/references.bib" \
  --csl="$pc/agu.csl" \
  --lua-filter "$pc/filters/task-labels.lua" \
  --lua-filter "$pc/filters/page-breaks.lua" \
  --filter "$pc/bin/figure-ref-filter" \
  --filter "$pc/bin/inline-figure-filter" \
  --filter pandoc-comments \
  --filter pandoc-crossref \
  --citeproc \
  -o "$PAPER_DIR/output/$name.docx" \
  $@

paper docx-unnumber-tasks "$PAPER_DIR/output/$name.docx"
